# ──────────────────────────────────────────────────────────────────
# GhostLine environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ──────────────────────────────────────────────────────────────────

# ── Twilio (PSTN + Media Streams) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── STT: Deepgram ────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US

# ── TTS + voice clone: ElevenLabs ───────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── LLM via LiteLLM (model-agnostic) ────────────────────────────
# Examples:
#   LITELLM_MODEL=openai/gpt-4o-mini
#   LITELLM_MODEL=anthropic/claude-3-5-sonnet-latest
#   LITELLM_MODEL=gemini/gemini-2.0-flash
#   LITELLM_MODEL=ollama/llama3.1
# Provider-specific keys (set only the ones you use):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LiteLLM base URL override (for local Ollama, vLLM, etc.):
# LITELLM_API_BASE=http://localhost:11434

# ── Tunnel ──────────────────────────────────────────────────────
NGROK_AUTHTOKEN=

# ── Optional overrides ──────────────────────────────────────────
# SQLITE_DB_PATH=sales_tracking.db
# BABBLE_NOISE_PATH=ambient_noise.wav
# LOG_LEVEL=INFO
# HOST=0.0.0.0
# PORT=8000
